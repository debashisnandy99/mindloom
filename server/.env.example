# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000

# ── Postgres (online DB, e.g. Neon) ───────────────────────────────────────
# Example: postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ── Redis (sessions + BullMQ + SSE pub/sub) ───────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Session / cookies (min 32 chars each) ─────────────────────────────────
SESSION_SECRET=
COOKIE_SECRET=
SESSION_NAME=mindloom.sid
SESSION_TTL_DAYS=7
# Enable double-submit CSRF protection on state-changing routes
ENABLE_CSRF=false

# ── OAuth: Google ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ── OAuth: GitHub ─────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# ── OpenAI embeddings ─────────────────────────────────────────────────────
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
EMBEDDING_BATCH_SIZE=64

# ── Chunking ──────────────────────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Qdrant (local docker compose) ─────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── AWS S3 (PDF storage) ──────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# ── Limits ────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
INDEXING_CONCURRENCY=3
