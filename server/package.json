{
  "name": "mindloom-server",
  "version": "1.0.0",
  "description": "Mindloom Express.js backend server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon",
    "dev:worker": "nodemon --config nodemon.worker.json",
    "dev:all": "bun run --parallel dev dev:worker",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/indexing.worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/xai": "^4.0.18",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@langchain/textsplitters": "^1.0.1",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "ai": "^7.0.37",
    "bullmq": "^5.81.2",
    "cheerio": "^1.2.0",
    "compression": "^1.8.1",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "multer": "^2.2.0",
    "openai": "^6.49.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^6.1.0",
    "winston": "^3.19.0",
    "youtube-transcript": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cookie-signature": "^1.1.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/hpp": "^0.2.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.17",
    "nodemon": "^3.1.4",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
